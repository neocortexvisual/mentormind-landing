<!-- Seção 04: manifesto em duas colunas; o monitor é recortado apenas dentro desta seção. -->
<section id="secao-04" class="section-04" aria-labelledby="section-04-title">
  <div class="section-04__copy">
    <p class="section-04__eyebrow">Quem ensina importa</p>
    <h2 id="section-04-title">O futuro da<br />educação<br />continua <span class="section-04__highlight">humano.</span></h2>
    <p class="section-04__description">A inteligência artificial apoia o planejamento.<br /> Seu olhar dá sentido à aula.</p>
    <p class="section-04__emphasis">Valorizamos quem ensina.</p>
    <p class="section-04__callout">Confira a matéria completa no blog&nbsp;<span aria-hidden="true">↗</span></p>
  </div>

  <figure class="section-04__figure">
    <img src="/section-04-monitor.png" alt="Pessoa de tênis laranja sobre um monitor antigo" width="1672" height="941" />
  </figure>
</section>

<style>
  .section-04 {
    position: relative;
    isolation: isolate;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 48px clamp(24px, 3.4vw, 64px);
    overflow: hidden;
    background: #000;
    color: #fff;
    font-family: Arial, Helvetica, sans-serif;
  }

  .section-04__copy {
    position: relative;
    z-index: 1;
    width: min(57%, 760px);
    transform: translateY(52px);
  }

  .section-04__eyebrow {
    margin: 0 0 24px;
    font-family: 'Courier New', Courier, monospace;
    font-size: clamp(17px, 1.55vw, 24px);
    font-weight: 700;
    letter-spacing: 0.19em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .section-04 h2 {
    margin: 0 0 24px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(50px, 5.85vw, 90px);
    font-weight: 700;
    letter-spacing: -0.052em;
    line-height: 0.91;
  }

  .section-04__highlight {
    color: #cb5230;
  }

  .section-04__description {
    margin: 0 0 14px;
    font-size: clamp(21px, 1.9vw, 28px);
    line-height: 1.24;
  }

  .section-04__emphasis {
    margin: 0 0 30px;
    font-size: clamp(21px, 1.85vw, 27px);
    font-weight: 700;
    line-height: 1.2;
  }

  .section-04__callout {
    display: inline-block;
    margin: 0;
    border-bottom: 2px solid currentColor;
    font-size: clamp(19px, 1.75vw, 26px);
    line-height: 1.18;
  }

  .section-04__figure {
    position: absolute;
    right: clamp(18px, 4.2vw, 70px);
    bottom: 0;
    width: min(37.5vw, 580px);
    aspect-ratio: 558 / 941;
    margin: 0;
    overflow: hidden;
  }

  .section-04__figure img {
    position: absolute;
    top: 0;
    left: 50%;
    display: block;
    width: auto;
    max-width: none;
    height: 100%;
    transform: translateX(-50%);
  }

  @media (max-width: 800px) {
    .section-04 {
      display: block;
      padding: clamp(56px, 10vw, 80px) clamp(24px, 6vw, 48px) 0;
    }

    .section-04__copy {
      width: 100%;
      transform: none;
    }

    .section-04 h2 {
      font-size: clamp(47px, 10vw, 72px);
    }

    .section-04__description br {
      display: none;
    }

    .section-04__figure {
      position: relative;
      right: auto;
      bottom: auto;
      width: min(79vw, 380px);
      margin: 36px auto 0;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector('.section-04');
  if (section) {
    // Distância adicional de scroll enquanto a Seção 04 permanece no topo da tela.
    const HOLD_SCREENS = { desktop: 0.45, mobile: 0.2 };
    const media = gsap.matchMedia();

    media.add('(prefers-reduced-motion: no-preference)', () => {
      ScrollTrigger.create({
        trigger: section,
        pin: true,
        start: 'top top',
        end: () => `+=${Math.round(window.innerHeight * (window.innerWidth <= 800 ? HOLD_SCREENS.mobile : HOLD_SCREENS.desktop))}`,
        pinSpacing: true,
        invalidateOnRefresh: true,
        anticipatePin: 1,
        // A Seção 03 fixa a cena antes desta seção e precisa ser medida primeiro.
        refreshPriority: -1,
      });
    });
  }
</script>
